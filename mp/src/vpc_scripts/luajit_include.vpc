//
// Purpose: LuaJIT Integration Include File
//
//=====================================================================================//

$Macro LUAJIT_DIR "$SRCDIR\lib\public\luajit"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\public"
		$PreprocessorDefinitions		"$BASE;LUA_ENABLED"
	}
	
	$Linker [$WIN32]
	{
		$AdditionalDependencies			"$BASE $LUAJIT_DIR\lua51.lib"
	}
	
	$Linker [$POSIX]
	{
		$AdditionalDependencies			"$BASE -lluajit-5.1"
	}
	
	$PostBuildEvent [$WIN32]
	{
		$CommandLine		"$BASE" "\n" \
							"IF NOT EXIST $QUOTE$OUTBINDIR$QUOTE MKDIR $QUOTE$OUTBINDIR$QUOTE" "\n" \
							"IF EXIST $QUOTE$LUAJIT_DIR\..\..\..\..\..\game\bin\lua51.dll$QUOTE COPY /Y $QUOTE$LUAJIT_DIR\..\..\..\..\..\game\bin\lua51.dll$QUOTE $QUOTE$OUTBINDIR\lua51.dll$QUOTE" "\n" \
							"IF ERRORLEVEL 1 GOTO BuildEventFailed" "\n"
	}
}

