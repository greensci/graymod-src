//
// Purpose: Lua Shared Source Files
// 
// This file is included by both client and server VPC files to ensure
// Lua bindings are compiled into both DLLs
//
//=====================================================================================//

$Project
{
	$Folder	"Lua"
	{
		$Folder "Source Files"
		{
			$File	"$SRCDIR\game\shared\luamanager.cpp"
			$File	"$SRCDIR\game\shared\luasrclib.cpp"
		}
		
		$Folder "Header Files"
		{
			$File	"$SRCDIR\game\shared\luamanager.h"
			$File	"$SRCDIR\game\shared\luasrclib.h"
			$File	"$SRCDIR\public\lua.h"
			$File	"$SRCDIR\public\lua.hpp"
			$File	"$SRCDIR\public\lualib.h"
			$File	"$SRCDIR\public\lauxlib.h"
			$File	"$SRCDIR\public\luaconf.h"
		}
	}
}
